+    }
+
+    public_configs = [ ":rust_ffi_libs_config" ]
+    all_dependent_configs = [ ":rust_ffi_libs_config" ]
+  }
+
+  config("rust_ffi_libs_config") {
+    _all_rust_libs = []
+    if (_needs_cxx) {
+      _all_rust_libs += [ "$root_out_dir/libcxx_cc.a" ]
+    }

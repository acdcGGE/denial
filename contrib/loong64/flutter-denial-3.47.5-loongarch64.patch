@@ -0,0 +1,63 @@
+# ICU (International Components for Unicode) — prebuilt from sysroot.
+# Use plain lib names so each toolchain resolves from its own sysroot.
+
+config("icuuc_link") {
+  libs = [ "icuuc" ]
+}
+
+config("icui18n_link") {
+  libs = [ "icui18n" ]
+}
+
+config("icudata_link") {
+  libs = [ "icudata" ]
+}
+
+source_set("icuuc") {
+  sources = []
+  all_dependent_configs = [ ":icuuc_link" ]
+  include_dirs = [ "source/common" ]
+}
+
+source_set("icui18n") {
+  sources = []
+  all_dependent_configs = [ ":icui18n_link" ]
+  include_dirs = [ "source/i18n", "source/common" ]
+}
+
+# icudata is required at link/runtime for ICU data tables.
+source_set("icudata") {
+  sources = []
+  all_dependent_configs = [ ":icudata_link" ]
+}
+
+# Header-only alias target used by skunicode and other consumers
+# that only need ICU headers, no link dep.
+source_set("headers") {
+  sources = []
+  include_dirs = [ "source/common", "source/i18n" ]
+}
+
+# Hidden-visibility aliases — GN cannot express symbol visibility on
+# prebuilt targets, so these just forward to the prebuilt targets.
+group("icuuc_hidden_visibility") {
+  public_deps = [ ":icuuc" ]
+}
+
+group("icui18n_hidden_visibility") {
+  public_deps = [ ":icui18n" ]
+}
+
+# Umbrella target — matches upstream consumer usage like "//flutter/third_party/icu".
+group("icu") {
+  public_deps = [ ":icuuc", ":icui18n" ]
+}
+
+# Config used by fml and other targets that only include ICU headers.
+# Critical: include_dirs must come BEFORE --sysroot so that clang finds
+# the bundled platform.h (with U_LIFETIME_BOUND defined) instead of
+# the sysroot's older ICU headers.
+config("icu_config") {
+  defines = [ "U_ENABLE_DYNAMIC_LOADING=0" ]
+  include_dirs = [ "source/common", "source/i18n" ]
+}

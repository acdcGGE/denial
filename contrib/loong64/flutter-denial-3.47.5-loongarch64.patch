diff --git a/engine/src/flutter/loong64/third_party_gn/flatbuffers/copy_flatc.py b/engine/src/flutter/loong64/third_party_gn/flatbuffers/copy_flatc.py
new file mode 100644
index 00000000..7349ec24
--- /dev/null
+++ b/engine/src/flutter/loong64/third_party_gn/flatbuffers/copy_flatc.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""Copy prebuilt flatc binary to the build output directory."""
+import os
+import shutil
+import sys
+
+src = "/tmp/flatc"
+if len(sys.argv) >= 2:
+    # GN passes --target_gen_dir as last arg, but we actually want $root_out_dir/flatc
+    # GN action args are: script outputs... let's handle it simply.
+    # Actually GN calls: python copy_flatc.py $output
+    dst = sys.argv[-1]
+else:
+    dst = os.path.join(os.environ.get("ROOT_OUT_DIR", "."), "flatc")
+
+# The GN action output list has only one entry: $root_out_dir/flatc
+# GN invokes: python copy_flatc.py $output_from_outputs
+# So sys.argv[1] should be the destination path.
+
+if os.path.exists(src):
+    os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
+    shutil.copy2(src, dst)
+    os.chmod(dst, 0o755)
+    print(f"Copied flatc: {src} -> {dst}")
+else:
+    print(f"ERROR: prebuilt flatc not found at {src}", file=sys.stderr)
+    sys.exit(1)
